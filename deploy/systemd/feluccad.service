[Unit]
Description=Felucca control plane (feluccad)
Documentation=https://github.com/alpham/infra-saas/docs/DEPLOYMENT.md
# systemd-modules-load preloads the wireguard module (modules-load.d/felucca.conf,
# shipped by install.sh) — ProtectKernelModules below forbids loading it here.
After=network-online.target systemd-modules-load.service
Wants=network-online.target

[Service]
Type=simple

# Run as a dedicated non-root user.  Create it with:
#   useradd --system --no-create-home --shell /sbin/nologin felucca
User=felucca
Group=felucca

# Config and env
EnvironmentFile=-/etc/felucca/feluccad.env
ExecStart=/usr/local/bin/feluccad --config /etc/felucca/feluccad.json

# Restart policy
Restart=on-failure
RestartSec=5s
TimeoutStartSec=30s
TimeoutStopSec=30s

# Capabilities (v4 P2): the wg overlay shells out to ip/wg (CAP_NET_ADMIN over
# netlink) and TLS binds :443/:80 (CAP_NET_BIND_SERVICE). Both are inert when
# the overlay/TLS are disabled; ambient because the service user is non-root
# and the caps must survive the execve into ip/wg.
AmbientCapabilities=CAP_NET_ADMIN CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_ADMIN CAP_NET_BIND_SERVICE

# Hardening
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
# AF_NETLINK: ip/wg configure the overlay interface over rtnetlink.
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX AF_NETLINK
RestrictNamespaces=true
LockPersonality=true
# Validated (PLAN-v4 P2.5 soak): flagged as a Go-runtime risk when these units
# were written for the Zig binaries, but pure-Go feluccad (no cgo, no JIT)
# tolerates it. The lab fleet ran under MDWE=true across the P2–P5 soak window
# (2026-06-12 → 2026-06-13, all conformance/verify load) with zero SIGSYS or
# W^X faults in the journal — keep it on.
MemoryDenyWriteExecute=true
RestrictRealtime=true
RestrictSUIDSGID=true
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM

# Allow writes only to the paths feluccad needs.
# /etc/felucca is config (read-only at runtime); writable paths are state + tmp.
# StateDirectory creates /var/lib/felucca owned by the service user on fresh
# installs and mounts it writable (so no ReadWritePaths entry for it, which
# would also fail namespacing if the dir were missing). Mode must be pinned:
# systemd re-applies it on every start and the default 0755 would silently
# loosen install.sh's 0750. Note systemd also re-chowns the tree to
# User=felucca if the top-level owner mismatches — don't park root-only
# secrets under /var/lib/felucca.
StateDirectory=felucca
StateDirectoryMode=0750
ReadOnlyPaths=/etc/felucca
ReadWritePaths=/usr/share/felucca

# Resource limits (tune per your node size)
LimitNOFILE=65536

[Install]
WantedBy=multi-user.target
