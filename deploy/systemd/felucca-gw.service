[Unit]
Description=Felucca ingress gateway (felucca-gw)
Documentation=https://github.com/alpham/infra-saas/docs/DEPLOYMENT.md
After=network-online.target
Wants=network-online.target

[Service]
Type=simple

# Same non-root user as feluccad (create per feluccad.service instructions).
User=felucca
Group=felucca

# Flags via env file: FELUCCA_GW_LISTEN, FELUCCA_GW_FELUCCAD, FELUCCA_TOKEN,
# FELUCCA_GW_DOMAIN, FELUCCA_GW_TENANT_LIMITS.
EnvironmentFile=-/etc/felucca/felucca-gw.env
ExecStart=/usr/local/bin/felucca-gw

Restart=on-failure
RestartSec=5s
TimeoutStartSec=30s
TimeoutStopSec=30s

# Hardening — the gateway is a pure userspace proxy: no devices, no state
# directory, nothing writable. CAP_NET_BIND_SERVICE only matters when
# listening below 1024 (e.g. :443 behind wildcard TLS); inert on :8088.
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
RestrictNamespaces=true
LockPersonality=true
# Same Go-runtime soak experiment as feluccad.service (PLAN-v4 P2.5): MDWE
# survives startup + the e2e suite; remove here too if the soak trips it.
MemoryDenyWriteExecute=true
RestrictRealtime=true
RestrictSUIDSGID=true
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM
ReadOnlyPaths=/etc/felucca

# Long-lived proxied connections (WebSocket/longpolling) need headroom.
LimitNOFILE=65536

[Install]
WantedBy=multi-user.target
