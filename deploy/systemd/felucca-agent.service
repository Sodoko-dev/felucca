[Unit]
Description=Felucca worker agent (felucca-agent)
Documentation=https://github.com/alpham/infra-saas/docs/DEPLOYMENT.md
# systemd-modules-load preloads br_netfilter (cross-tenant isolation is
# SILENTLY OFF without it — the agent logs an error if missing) and wireguard
# (--join). ProtectKernelModules below forbids the agent loading them itself;
# install.sh ships modules-load.d/felucca.conf.
After=network-online.target systemd-modules-load.service
Wants=network-online.target
# The host firewall is not optional. The agent's API answers on the bridge
# gateway that every guest routes through, and guest->host packets hit the
# INPUT hook, which the agent's own forward-chain isolation never sees — so
# without the felucca0 drop a tenant with root in their own sandbox reaches the
# node's root control API. install.sh writes /etc/felucca/firewall.nft and the
# felucca-firewall unit; a node without that rule must not serve the API, and
# must not carry guest traffic either.
#
# That is enforced by the two ExecStartPre= lines below, which look for the
# rule itself in the kernel — not by a Requires= on the unit that loads it.
# Requires= only says the firewall unit ran once: the table can be flushed
# afterwards and the agent still starts. It also restarted the agent whenever
# the firewall unit was restarted, and left the agent down with no retry when
# that unit failed to start. Wants= + After= still loads the rules first at
# boot (ADR-0011).
Wants=felucca-firewall.service
After=felucca-firewall.service
# Firecracker must be present before the agent starts.
ConditionPathExists=/usr/local/bin/firecracker
# Never give up on starting the agent. Sandboxes keep running while it is down
# (KillMode=process below), but nothing watches them, refills the pool or
# answers the control plane — so "tried five times in ten seconds, staying
# failed" is the wrong end state for this unit. With the default limit, a
# handful of quick manual restarts is enough to reach it.
StartLimitIntervalSec=0

[Service]
Type=simple

# The agent MUST run as root: it creates tap interfaces, programs nftables,
# sets ip_forward, and opens /dev/kvm.  PrivilegeEscalation is constrained by
# the capability allow-list below instead of DynamicUser / non-root.
User=root
Group=root

# Config and env
EnvironmentFile=-/etc/felucca/agent.env
# Log verbosity (v4 P6, tracing): RUST_LOG overrides the default "info" —
# e.g. RUST_LOG=debug in agent.env for a debugging session. Journald captures
# the structured key=value output; grep by request_id to follow one feluccad
# API call into this agent.
#
# Start gate: the guest fence must be in the kernel (see [Unit]).
#
# "The fence" is the rule `iifname "felucca0" drop` in chain input of table
# inet felucca_host, exactly as install.sh generates it. A chain that merely
# exists does not pass, and neither does a rules file that lost that line or
# rewrote it (to count or log what it drops, add a rule of its own in front
# of it — do not change the line).
#
# Step 1 heals. Sandboxes outlive the agent, so the usual way to get here
# without the fence is a ruleset flush while guests are running — and
# felucca-firewall is then still "active (exited)", so Wants= above does
# nothing. This asks systemd to load the rules file again: a reload when that
# unit is active, a start when it is stopped or failed. Best effort ("-").
# "+" so that it does not depend on what a given systemd lets a caller with
# only this unit's two capabilities do (on systemd 255 it works either way).
# When the fence is loaded this step does nothing at all.
#
# Step 2 is the gate. Still no fence: take the guests' bridge down — they keep
# running, but must not stay on a network that has no fence between them and
# this host while no agent is there — say why, and fail. The unit retries
# every RestartSec and every retry runs step 1 again, so once the rules file
# loads the agent comes back by itself: no reload, no start. The agent raises
# felucca0 again itself, and only after its own isolation checks have passed.
#
# Neither step prints the rules into the journal. nft is named by its absolute
# path on purpose (install.sh rewrites it where nft lives somewhere else);
# grep, ip and systemctl are found through PATH.
ExecStartPre=-+/bin/sh -c '/usr/sbin/nft list chain inet felucca_host input 2>/dev/null | grep -q "iifname .felucca0. drop" || systemctl reload-or-restart felucca-firewall.service'
ExecStartPre=/bin/sh -c '/usr/sbin/nft list chain inet felucca_host input 2>/dev/null | grep -q "iifname .felucca0. drop" && exit 0; ip link set dev felucca0 down 2>/dev/null; echo "felucca-agent: not starting: the guest fence (iifname felucca0 drop) is not loaded in table inet felucca_host, so the guest bridge felucca0 was taken down. Fix /etc/felucca/firewall.nft - systemctl status felucca-firewall shows why it does not load - and the next start attempt loads it by itself, no reload needed." >&2; exit 1'
ExecStart=/usr/local/bin/felucca-agent --config /etc/felucca/felucca-agent.json

# Stopping, restarting or losing the agent must not touch the sandboxes.
#
# Every Firecracker is a child of the agent and lives in this unit's cgroup.
# With systemd's default (KillMode=control-group) stopping the unit — a
# restart, an upgrade, a crash followed by Restart= — kills the whole cgroup,
# i.e. every sandbox on the worker. KillMode=process signals the agent alone.
# The Firecrackers keep running; the next agent adopts them from
# {data_dir}/instances/*/meta.json, after checking that each recorded pid
# really is that instance's Firecracker (ADR-0011).
#
# What follows from it:
#   systemctl stop felucca-agent      leaves every sandbox running (unmanaged
#                                     until the agent is started again)
#   systemctl kill felucca-agent      signals EVERY process in the unit, so
#                                     every sandbox — use --kill-whom=main to
#                                     signal the agent only
#   power off all sandboxes on a node:
#       systemctl stop felucca-agent && systemctl kill felucca-agent
#   each restart logs, per running sandbox, one "Unit process N (firecracker)
#   remains running after unit stopped." and two "Found left-over process N
#   (firecracker) in control group while starting unit. Ignoring." (once
#   before the pre-start commands, once before the agent itself): expected,
#   do not alert on them.
#   a start that keeps failing never turns the unit `failed`
#   (StartLimitIntervalSec=0 above): it stays activating/auto-restart and
#   repeats two or three of those lines per sandbox every RestartSec. Alert on
#   the agent being away (NRestarts, the node `down` in feluccad), not on
#   `failed`.
# Not "mixed": that SIGKILLs whatever is left in the cgroup as soon as the
# agent itself has exited.
KillMode=process
# One out-of-memory kill must cost one sandbox, not all of them.
#
# Every Firecracker is in this unit's cgroup, and with systemd's default
# (OOMPolicy=stop) the kernel OOM-killing ANY process of the unit stops the
# unit. `continue` leaves the unit running: the agent sees that one VMM exit
# and marks that one sandbox `error`.
# (KillMode=process alone already keeps the other VMMs alive through such a
# stop, but the agent would still be taken down and restarted for nothing.)
OOMPolicy=continue
# systemd-oomd, where it is enabled, does not pick a process: it kills a whole
# cgroup, and this one holds every sandbox on the worker. Keep it out; the
# kernel OOM killer still acts here, one process at a time.
ManagedOOMPreference=omit
# No OOMScoreAdjust= here on purpose. It would be inherited by every
# Firecracker, and the floor it sets is one an unprivileged process may lower
# itself back to — a compromised VMM could make itself the last to die.
# Instead the agent marks each Firecracker as a preferred victim when it
# spawns or adopts it (oom_score_adj 300), and stays at 0 itself.
# Restart policy. `always`, not `on-failure`: an agent that was ended by a
# plain SIGTERM (kill <pid>) exits "cleanly" and on-failure would leave it
# down, with its sandboxes running unattended. `systemctl stop` is still
# honoured.
Restart=always
RestartSec=5s
TimeoutStartSec=60s
TimeoutStopSec=60s

# Snapshot files are tenant memory: mem.bin under {data_dir}/instances/<id>/ is
# a verbatim dump of the guest's RAM, and every Firecracker child inherits this
# umask for the files and sockets it creates. The default 0022 would leave them
# 0644 and readable by any local account on the worker.
UMask=0077

# Device access — /dev/kvm for Firecracker microVMs; /dev/net/tun for the
# per-VM tap devices (both `ip tuntap add` and Firecracker itself open it,
# and DevicePolicy=closed applies to every process in the cgroup).
DeviceAllow=/dev/kvm rw
DeviceAllow=/dev/net/tun rw
DevicePolicy=closed

# Capabilities required for tap/bridge/nftables setup.
# All others are dropped.
AmbientCapabilities=CAP_NET_ADMIN CAP_NET_RAW
CapabilityBoundingSet=CAP_NET_ADMIN CAP_NET_RAW

# Hardening (compatible with root + CAP_NET_ADMIN)
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=false
ProtectKernelModules=true
ProtectControlGroups=false
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX AF_NETLINK
RestrictNamespaces=true
LockPersonality=true
RestrictRealtime=true
RestrictSUIDSGID=true
# @sandbox: Firecracker hardens itself with per-thread seccomp filters via
# seccomp(2), which @system-service does not allow — without it every FC
# child dies with SIGSYS right after its API socket comes up (audit
# type=1326 syscall=277/seccomp on aarch64).
SystemCallFilter=@system-service @network-io @sandbox

# Writable paths for VM instances, kernels, images. (No /run/felucca: nothing
# uses it — FC API sockets live under {data_dir}/instances/<id>/ — and a
# missing ReadWritePaths entry fails mount namespacing on every boot with
# 226/NAMESPACE, /run being tmpfs.) Every entry must exist before start
# (install.sh creates them); a non-default data_dir needs a drop-in that
# RESETS the list:  ReadWritePaths=  then  ReadWritePaths=<dir> /etc/felucca
ReadWritePaths=/srv/felucca /etc/felucca

# Resource limits — each Firecracker child needs an FD for its unix socket
LimitNOFILE=524288

[Install]
WantedBy=multi-user.target
