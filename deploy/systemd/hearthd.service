[Unit]
Description=Hearth control plane (hearthd)
Documentation=https://github.com/alpham/infra-saas/docs/DEPLOYMENT.md
# systemd-modules-load preloads the wireguard module (modules-load.d/hearth.conf,
# shipped by install.sh) — ProtectKernelModules below forbids loading it here.
After=network-online.target systemd-modules-load.service
Wants=network-online.target

[Service]
Type=simple

# Run as a dedicated non-root user.  Create it with:
#   useradd --system --no-create-home --shell /sbin/nologin hearth
User=hearth
Group=hearth

# Config and env
EnvironmentFile=-/etc/hearth/hearthd.env
ExecStart=/usr/local/bin/hearthd --config /etc/hearth/hearthd.json

# Restart policy
Restart=on-failure
RestartSec=5s
TimeoutStartSec=30s
TimeoutStopSec=30s

# Capabilities (v4 P2): the wg overlay shells out to ip/wg (CAP_NET_ADMIN over
# netlink) and TLS binds :443/:80 (CAP_NET_BIND_SERVICE). Both are inert when
# the overlay/TLS are disabled; ambient because the service user is non-root
# and the caps must survive the execve into ip/wg.
AmbientCapabilities=CAP_NET_ADMIN CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_ADMIN CAP_NET_BIND_SERVICE

# Hardening
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
# AF_NETLINK: ip/wg configure the overlay interface over rtnetlink.
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX AF_NETLINK
RestrictNamespaces=true
LockPersonality=true
# Known soak experiment (PLAN-v4 P2): flagged as a Go-runtime risk when these
# units were written for the Zig binaries. Pure-Go hearthd (no cgo, no JIT)
# should tolerate it — the 48h soak is the verdict; remove if it trips.
MemoryDenyWriteExecute=true
RestrictRealtime=true
RestrictSUIDSGID=true
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM

# Allow writes only to the paths hearthd needs.
# /etc/hearth is config (read-only at runtime); writable paths are state + tmp.
ReadOnlyPaths=/etc/hearth
ReadWritePaths=/var/lib/hearth /usr/share/hearth

# Resource limits (tune per your node size)
LimitNOFILE=65536

[Install]
WantedBy=multi-user.target
